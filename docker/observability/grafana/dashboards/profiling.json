{
  "uid": "showcase-profiling",
  "title": "Showcase — profiling spans",
  "tags": [
    "showcase"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 span duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, component, message) (rate(symfony_profiling_span_duration_histogram_seconds_bucket[5m])))",
          "legendFormat": "{{component}} {{message}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spans per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (component, message) (rate(symfony_profiling_span_duration_histogram_seconds_count[1m]))",
          "legendFormat": "{{component}} {{message}}"
        }
      ]
    }
  ]
}
