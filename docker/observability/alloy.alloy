// Only this compose project: the Docker API also exposes unrelated containers on the host.
discovery.docker "containers" {
  host = "tcp://docker-proxy:2375"
  // The 60s default misses workers started right after Alloy, and e2e runs right after "up --wait".
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=bundles-showcase"]
  }
}

discovery.relabel "services" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "logs" {
  host       = "tcp://docker-proxy:2375"
  targets    = discovery.relabel.services.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Spans and logs of the apps (tracing-bridge-otlp, OTLP over HTTP): spans to Tempo, logs to Loki's OTLP endpoint.
otelcol.receiver.otlp "apps" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.apps.input]
    logs   = [otelcol.processor.batch.apps.input]
  }
}

otelcol.processor.batch "apps" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    logs   = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
